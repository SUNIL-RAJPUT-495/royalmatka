{
  "id": "/",
  "name": "Royal Matka",
  "short_name": "RoyalMatka",
  "description": "Royal Matka Official Gaming, Live Support & Casino App",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#f97316",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["games", "entertainment", "sports"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.royalmatka.app",
      "id": "com.royalmatka.app"
    },
    {
      "platform": "webapp",
      "url": "https://royalmatkaapi.growva.tech/manifest.json"
    }
  ],
  "iarc_rating_id": "e84b3b5c-2e67-466a-93e1-30114006c019",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/support"
  },
  "share_target": {
    "action": "/support",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "scope_extensions": [
    {
      "type": "web",
      "origin": "https://royalmatkaapi.growva.tech"
    },
    {
      "type": "web",
      "origin": "https://royalmatka.growva.tech"
    },
    {
      "type": "web",
      "origin": "https://royalmatka.com"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+royalmatka",
      "url": "/?protocol=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Support Chat",
      "short_name": "Support",
      "description": "Chat with Royal Matka 24/7 Support",
      "url": "/support",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bid History",
      "short_name": "History",
      "description": "View Matka bid history and winnings",
      "url": "/bids-history",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Royal Matka Results",
      "short_name": "Results",
      "description": "View live Matka game results",
      "tag": "matka-results",
      "template": "matka-results-template",
      "ms_ac_template": "/widgets/results.json",
      "data": "/api/market/get-all-markets",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/pwa-512x512.png",
          "sizes": "512x512",
          "type": "image/png",
          "label": "Matka Results Widget"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Royal Matka Mobile Home"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Royal Matka Dashboard"
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
