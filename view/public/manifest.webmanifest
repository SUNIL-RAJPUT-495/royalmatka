{
  "id": "/",
  "name": "Royal Matka",
  "short_name": "RoyalMatka",
  "description": "Royal Matka Official Gaming, Live Support & Casino App",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#f97316",
  "lang": "en-US",
